{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rillmux",
  "mainBinaryName": "Rillmux",
  "version": "0.5.4",
  "identifier": "com.wibias.rillmux",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rillmux",
        "width": 1280,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://api.twitch.tv https://id.twitch.tv https://*.twitch.tv https://*.sentry.io https://github.com https://*.github.com https://objects.githubusercontent.com; img-src 'self' https: data:; style-src 'self'; frame-src https://www.twitch.tv https://twitch.tv"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5NDQ1N0MzMkM1M0MyQTUKUldTbHdsTXN3MWRFV2U2akl3bjVPUFJmVlFocnBNaWo1S25BekQ2MXJjVXJFN2ZzVWxmKzJGMlIK",
      "endpoints": [
        "https://github.com/Wibias/Rillmux/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "stg"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
