{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Privileged capability for the main Rillmux window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-is-visible",
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-skip-taskbar",
    "core:webview:allow-create-webview-window",
    "core:tray:default",
    "core:app:allow-default-window-icon",
    "opener:default",
    "store:default",
    "notification:default",
    "updater:default",
    "deep-link:default",
    "process:default",
    "dialog:allow-open",
    "window-controls:default",
    "allow-get-doctor-report",
    "allow-get-twitch-client-id",
    "allow-auth-get-session",
    "allow-auth-start-device-login",
    "allow-auth-poll-device-login",
    "allow-auth-logout",
    "allow-twitch-web-auth-status",
    "allow-twitch-web-auth-save",
    "allow-twitch-web-auth-clear",
    "allow-channel-points-claim-auth-status",
    "allow-channel-points-claim-auth-start-device-login",
    "allow-channel-points-claim-auth-poll-device-login",
    "allow-channel-points-claim-auth-clear",
    "allow-viewer-presence-sync",
    "allow-viewer-presence-status",
    "allow-channel-points-refresh",
    "allow-channel-points-cached",
    "allow-channel-points-vote-poll",
    "allow-channel-points-vote-prediction",
    "allow-channel-points-redeem-reward",
    "allow-helix-fetch",
    "allow-stream-start",
    "allow-stream-list",
    "allow-stream-stop",
    "allow-stream-stop-all",
    "allow-stream-toggle-mute",
    "allow-open-chatterino-chat",
    "allow-close-owned-chatterino",
    "allow-layout-watching",
    "allow-dock-set-linked",
    "allow-dock-set-chat-fraction",
    "allow-dock-cycle-monitor",
    "allow-diagnostics-set-debug",
    "allow-diagnostics-open-logs",
    "allow-diagnostics-open-crashes",
    "allow-eventsub-sync",
    "allow-raid-overlay-place",
    "allow-channel-points-hud-place",
    "allow-overlay-fit-webview",
    "allow-overlay-place-hud",
    "allow-poll-overlay-place",
    "allow-poll-overlay-raise",
    "allow-app-quit",
    "allow-enable-title-bar-overlay"
  ]
}
